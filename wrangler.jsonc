{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-todo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // 毎朝8:00 JST (= 23:00 UTC) に期限リマインドを送る
    "crons": ["0 23 * * *"]
  },
  "vars": {
    // Notionの「タスク管理」データソースID（秘密情報ではないのでvarsでOK）
    "NOTION_DATA_SOURCE_ID": "c457a247-0051-4be5-8572-4bbb571479ea",
    // Web PushのVAPID公開鍵(公開情報)と連絡先。秘密鍵はsecretのVAPID_PRIVATE_KEY
    "VAPID_PUBLIC_KEY": "BAESEznZW3V9iwPUeIIZk79190EDEaDBD82f8xc0ir1rdGmDoWyJgK-TXdYL4P8sq4ikKnGyiO6g7Y5YfUU1NBc",
    "VAPID_SUBJECT": "mailto:taichi.klavier0326@gmail.com"
  },
  "kv_namespaces": [
    // プッシュ通知の購読情報(端末ごとのエンドポイント)を保存する
    { "binding": "PUSH_SUBS", "id": "b18e4fac096d4a8b9922a89aa17ac340" }
  ],
  "unsafe": {
    "bindings": [
      // トークン漏洩時にAPIクレジットを溶かされる速度を抑える減速装置。
      // 認証通過後のリクエストのみカウントする(実装側参照)
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
  // シークレットは `wrangler secret put <NAME>` で登録する:
  //   AUTH_TOKEN         - このAPIを叩くための合言葉（自分で決めるランダム文字列）
  //   ANTHROPIC_API_KEY  - console.anthropic.com で発行
  //   NOTION_TOKEN       - notion.so/my-integrations で発行（ntn_...）
}
